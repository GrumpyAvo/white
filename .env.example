# Spotify API credentials — copy this file to `.env` and fill in the values.
#
# 1. Create an app at https://developer.spotify.com/dashboard
# 2. Copy the Client ID and Client Secret from your app's Settings.
# 3. Add the Redirect URI  http://127.0.0.1:8888/callback  to your app's
#    Redirect URIs (Dashboard → your app → Settings → Edit settings).
#    IMPORTANT: use 127.0.0.1, NOT localhost — Spotify no longer accepts
#    localhost aliases. Loopback IP literals are the only allowed http URIs.
# 4. Run  python scripts/spotify_oauth.py  — it opens your browser, authorizes,
#    and fills in SPOTIFY_REFRESH_TOKEN automatically.
#
# `.env` is gitignored — never commit real credentials. Render uses real
# environment variables instead of this file (SPOTIFY_CLIENT_ID,
# SPOTIFY_CLIENT_SECRET, SPOTIFY_REFRESH_TOKEN).

SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Generated by scripts/spotify_oauth.py
SPOTIFY_REFRESH_TOKEN=
